# Copie ce fichier en « .env » (en local) ou ajoute ces variables dans Netlify (Site configuration → Environment variables).
# Sans VITE_SUPABASE_URL, le site fonctionne en mode démo (tout est simulé).

# — Serveur Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# — Numéros qui reçoivent les paiements (laisser vide pour masquer un moyen)
VITE_NUMERO_WAVE=07 00 00 00 00
VITE_NUMERO_ORANGE=07 00 00 00 00
VITE_NUMERO_MTN=
VITE_NUMERO_MOOV=
VITE_NUMERO_DJAMO=07 00 00 00 00
VITE_NOM_BENEFICIAIRE=Ton nom tel qu'il apparaît chez Wave / Orange Money

# — Optionnel : lien de paiement Wave Business
VITE_LIEN_WAVE=

# — WhatsApp du support (format international sans +)
VITE_WHATSAPP=2250700000000

# — Paiement automatique Djamo (mettre 1 une fois les clés installées dans Supabase)
VITE_DJAMO_AUTO=0
